# ---------- Azure AI Foundry ----------
# Endpoint do projeto Foundry (autenticação via Entra ID / az login - sem chaves)
FOUNDRY_PROJECT_ENDPOINT=https://foundry-hackbr-ghcp.services.ai.azure.com/api/projects/prj-foundry-HackBR-GHCP-24
# Nome do deployment do modelo de chat (vazio = o script escolhe automaticamente: gpt-4.1, gpt-4o, ...)
FOUNDRY_MODEL_DEPLOYMENT=
# Nome da conexão Bing Grounding no projeto (vazio = detecta automaticamente)
FOUNDRY_BING_CONNECTION_NAME=
# Preenchidos pelo script agent/provision_agent.py
FOUNDRY_AGENT_NAME=
FOUNDRY_AGENT_ID=

# ---------- Aplicação ----------
# auto = usa o Foundry se FOUNDRY_AGENT_NAME estiver definido (com fallback para mock); mock = só dados de exemplo; foundry = só Foundry
APP_MODE=auto
APP_USERNAME=admin
# Senha do usuário demo (é armazenada apenas como hash PBKDF2 no banco)
APP_PASSWORD=troque-esta-senha
# Segredo para assinar os tokens JWT (gere com: python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=
JWT_EXPIRES_MINUTES=480
DATABASE_PATH=data/leads.db
# Popula o banco com leads de exemplo na primeira execução
SEED_DEMO_DATA=true
